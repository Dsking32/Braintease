generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  CONTENT_MANAGER
  SUPPORT_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SEQUENCE
  PATTERN
  NUMERICAL
  WORD
  LOGIC
  MEMORY
  IMAGE_BASED
  AUDIO
  VIDEO
}

enum QuestionStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum ChallengeStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum SubStatus {
  PENDING
  ACTIVE
  GRACE_PERIOD
  PAYMENT_FAILED
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum TxStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
  REFUNDED
  UNKNOWN
}

enum Channel {
  WEB
  USSD
  SMS
  MOBILE
}

model User {
  id String @id @default(uuid())
  msisdn String @unique
  role Role @default(PLAYER)
  status UserStatus @default(ACTIVE)
  xp Int @default(0)
  createdAt DateTime @default(now())
  profile UserProfile?
  streak Streak?
  challenges Challenge[]
  attempts QuestionAttempt[]
  subscriptions Subscription[]
  transactions BillingTransaction[]
}
model UserProfile {
  userId String @id
  user User @relation(fields: [userId], references: [id])
  displayName String
  ageRange String?
  gender String?
  state String?
  interests String[]
}
model OtpRequest {
  id String @id @default(uuid())
  msisdn String
  codeHash String
  expiresAt DateTime
  attempts Int @default(0)
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([msisdn, createdAt])
}
model Category {
  id String @id @default(uuid())
  name String @unique
  description String?
  icon String?
  color String?
  active Boolean @default(true)
  questions Question[]
}
model Question {
  id String @id @default(uuid())
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  type QuestionType @default(MULTIPLE_CHOICE)
  text String
  image String?
  optionA String?
  optionB String?
  optionC String?
  optionD String?
  correctAnswer String
  explanation String?
  difficulty Int
  points Int?
  timeLimitSec Int @default(30)
  status QuestionStatus @default(DRAFT)
  source String?
  challengeQuestions ChallengeQuestion[]
  expiresAt DateTime?
  createdBy String?
  reviewedBy String?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, categoryId, difficulty])
}
model Challenge {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  localDate String
  status ChallengeStatus @default(IN_PROGRESS)
  totalQuestions Int
  correctAnswers Int @default(0)
  totalScore Int @default(0)
  startedAt DateTime @default(now())
  completedAt DateTime?
  questions ChallengeQuestion[]
  attempts QuestionAttempt[]
  @@unique([userId, localDate])
}
model ChallengeQuestion {
  challengeId String
  questionId String
  order Int
  pointsAvailable Int
  servedAt DateTime?
  challenge Challenge @relation(fields: [challengeId], references: [id])
  question Question @relation(fields: [questionId], references: [id])
  @@id([challengeId, questionId])
}
model QuestionAttempt {
  id String @id @default(uuid())
  userId String
  challengeId String
  questionId String
  selectedAnswer String?
  correct Boolean
  responseTimeMs Int
  pointsAwarded Int
  flagged Boolean @default(false)
  answeredAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  challenge Challenge @relation(fields: [challengeId], references: [id])
  @@unique([challengeId, questionId])
  @@index([userId, questionId])
}
model Streak {
  userId String @id
  user User @relation(fields: [userId], references: [id])
  current Int @default(0)
  longest Int @default(0)
  lastDate String?
}
model Level {
  id Int @id
  name String
  minXp Int
}
model Plan {
  id String @id @default(uuid())
  code String @unique
  name String
  description String?
  priceMinor Int
  currency String @default("NGN")
  interval String
  intervalValue Int @default(1)
  features Json @default("{}")
  active Boolean @default(true)
  subscriptions Subscription[]
}
model Subscription {
  id String @id @default(uuid())
  userId String
  planId String
  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])
  status SubStatus @default(PENDING)
  channel Channel
  provider String
  startsAt DateTime?
  endsAt DateTime?
  autoRenew Boolean @default(true)
  cancelAtPeriodEnd Boolean @default(false)
  createdAt DateTime @default(now())
  events SubscriptionEvent[]
  transactions BillingTransaction[]
  @@index([userId, status])
}
model SubscriptionEvent {
  id String @id @default(uuid())
  subscriptionId String
  type String
  payload Json?
  createdAt DateTime @default(now())
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}
model BillingTransaction {
  id String @id @default(uuid())
  userId String
  subscriptionId String?
  amountMinor Int
  currency String @default("NGN")
  provider String
  mno String?
  status TxStatus @default(PENDING)
  providerTransactionId String? @unique
  reference String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
}
model AuditLog {
  id String @id @default(uuid())
  actorId String
  action String
  entity String
  entityId String
  oldValue Json?
  newValue Json?
  ip String?
  createdAt DateTime @default(now())
}
model SystemSetting {
  key String @id
  value Json
}
